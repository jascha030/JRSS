{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "JRSS",
	"version": "0.0.1",
	"identifier": "com.jrss.desktop",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://127.0.0.1:1420",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"url": "/",
				"title": "JRSS",
				"width": 1600,
				"height": 900,
				"minWidth": 1024,
				"minHeight": 640,
				"fullscreen": false,
				"decorations": true,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": {
					"x": 16,
					"y": 28
				},
				"resizable": true,
				"transparent": false,
				"windowEffects": {
					"effects": ["sidebar"],
					"state": "followsWindowActiveState"
				}
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/image_cache/**/*"]
			}
		}
	},
	"plugins": {
		"shell": {
			"open": true
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
