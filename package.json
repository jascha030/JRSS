{
	"name": "jrss",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync || echo ''",
		"tauri:build": "tauri build",
		"tauri:dev": "tauri dev",
		"tauri:dev:editor": "LAUNCH_EDITOR=scripts/open-editor.sh bun run tauri:dev",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"vite:build": "vite build",
		"vite:dev": "vite dev --host 127.0.0.1 --port 1420",
		"vite:preview": "vite preview"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.1",
		"monaco-editor": "^0.52.0",
		"@skeletonlabs/skeleton": "^4.15.2",
		"@skeletonlabs/skeleton-svelte": "^4.15.2",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-global-shortcut": "^2.3.1",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"node-vibrant": "^4.0.4",
		"postcss": "^8.5.10",
		"svelte-sonner": "^1.1.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.11.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.0",
		"@vitest/ui": "4.1.6",
		"eslint": "^10.4.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"happy-dom": "^20.9.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.8",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.0.13",
		"vitest": "^4.1.6"
	},
	"overrides": {
		"file-type": "^21.3.1",
		"cookie": "^0.7.0",
		"postcss": "8.5.10",
		"ws": "8.20.1",
		"brace-expansion": "5.0.6"
	}
}
