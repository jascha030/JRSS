{
	"name": "jrss",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev --host 127.0.0.1 --port 1420",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"tauri:build": "tauri build",
		"tauri:dev": "tauri dev",
		"tauri:dev:editor": "LAUNCH_EDITOR=scripts/open-editor.sh bun run tauri:dev",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@choochmeque/tauri-plugin-sharekit-api": "^0.4.0-rc.5",
		"@iconify/svelte": "^5.2.2",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-global-shortcut": "^2.3.2",
		"@tauri-apps/plugin-log": "^2.9.0",
		"@tauri-apps/plugin-opener": "~2.5.4",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"monaco-editor": "^0.55.1",
		"postcss": "^8.5.23",
		"svelte-sonner": "^1.1.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.1",
		"@vitest/ui": "4.1.10",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"happy-dom": "^20.11.1",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"file-type": "^21.3.1",
		"cookie": "^0.7.0",
		"postcss": "^8.5.23",
		"brace-expansion": "^5.0.8",
		"dompurify": "^3.4.12",
		"ws": "^8.21.0"
	}
}
